# ==========================================================================
# Backend configuration
#
# Copy to backend/.env and adjust. NEVER commit the real .env.
#
# Every value below is a LOCAL DEVELOPMENT default. Production differs only by
# configuration - no application code needs to change to move from localhost to
# a hosted environment. See deploy/README.md for the migration guide.
# ==========================================================================

# ---- Application ----------------------------------------------------------
APP_ENV=development
DEBUG=true

# Comma-separated. Do not use "*" outside local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database -------------------------------------------------------------
# SQLite by default so the MVP needs no extra infrastructure.
# Production:  postgresql+psycopg://sma:STRONG_PASSWORD@db:5432/social
DATABASE_URL=sqlite:///./social_media.db
SQL_ECHO=false

# ==========================================================================
# Credential encryption  (REQUIRED to store ANY secret from the UI)
# ==========================================================================
# Encrypts every stored secret: AI provider keys AND Buffer tokens.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If unset, AI_ENCRYPTION_KEY is used as a fallback so older installs keep
# working. Set this one explicitly for a new deployment.
#
# ROTATION: changing it makes every already-stored secret undecryptable. Back
# the value up somewhere safe before deploying. See deploy/README.md.
CREDENTIAL_ENCRYPTION_KEY=

# ---- AI provider key encryption -------------------------------------------
# Legacy key. Still honoured as a fallback, and used by AI_SETTINGS only if
# CREDENTIAL_ENCRYPTION_KEY is unset.
AI_ENCRYPTION_KEY=

# ==========================================================================
# Publishing engine
# ==========================================================================
# Which component performs the actual Buffer call.
#
#   n8n     (DEFAULT - keeps an existing install working untouched)
#           Backend -> n8n webhook -> workflow -> Buffer.
#           The workflow used can be the original one, or the generic export in
#           deploy/n8n/social-publishing-workflow.json.
#
#   direct  Backend -> Buffer. No n8n needed at publish time, one less hop.
#           Requires at least one connected Buffer integration in the UI.
#
# Either way the backend resolves the credential and the external channel id,
# so the workflow never holds a Buffer token.
PUBLISH_ENGINE=n8n

# ---- n8n publishing engine ----------------------------------------------
# The webhook the backend POSTs a publish request to.
# Use the production /webhook/ path, not /webhook-test/ (test mode only).
N8N_PUBLISH_WEBHOOK_URL=http://localhost:5678/webhook/social/publish

# Optional shared secret. Sent as X-N8N-Secret when set.
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_SECONDS=60
N8N_VERIFY_TLS=true

# Base URL the n8n workflow uses to call back into THIS backend.
#
# "localhost" means the machine or container making the request - which is
# n8n, not your browser. Pick the value that works for your n8n runtime:
#
#   n8n on the same host, no Docker  -> http://localhost:8000
#   n8n in Docker on your PC        -> http://host.docker.internal:8000
#   n8n in the same compose network  -> http://backend:8000
#   n8n hosted in the cloud          -> https://api.your-domain.com
N8N_BACKEND_BASE_URL=http://localhost:8000

# Shared secret the n8n workflow presents on /internal/publish.
# Leave EMPTY to disable that endpoint entirely (it will 404).
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# Must match SMA_INTERNAL_SECRET on the n8n side. Never commit either value.
INTERNAL_SERVICE_SECRET=

# ---- Buffer API ----------------------------------------------------------
# Buffer's supported API is GraphQL over one endpoint. The legacy
# api.bufferapp.com REST API is deprecated and is not used.
BUFFER_API_BASE_URL=https://api.buffer.com
BUFFER_TIMEOUT_SECONDS=30

# ---- Optional API auth ----------------------------------------------------
# Leave empty for local development. Set a value to require the
# X-API-Key header on every /api route.
# REQUIRED before exposing the backend publicly.
API_KEY=

# ---- Publishing defaults --------------------------------------------------
DEFAULT_TIMEZONE=Asia/Dhaka
MAX_SCHEDULE_DAYS_AHEAD=365

# ---- Media storage -------------------------------------------------------
# Where uploaded files are written.
MEDIA_STORAGE_DIR=./media

# The URL prefix BUFFER will use to DOWNLOAD an uploaded file.
#
# IMPORTANT: Buffer is a cloud service and fetches media over the public
# internet. A localhost value CANNOT work. Either:
#   (a) run a tunnel and set PUBLIC_MEDIA_BASE_URL to the public URL, or
#   (b) set MEDIA_STORAGE_BACKEND=s3 (recommended).
#
# If this is empty the upload still works and the UI shows a warning.
PUBLIC_MEDIA_BASE_URL=

# The URL the BROWSER uses for thumbnails and previews. Keep this pointing at
# your own API. A tunnel serves an interstitial HTML page to browsers, which
# would render as a broken thumbnail, while still serving the real file to
# Buffer - so previews must bypass the tunnel.
PREVIEW_MEDIA_BASE_URL=http://localhost:8000/api/media

# Used to build absolute media URLs when PUBLIC_MEDIA_BASE_URL is empty.
PUBLIC_API_BASE_URL=http://localhost:8000

# Hard ceiling for one upload, in bytes. Default 25 MiB.
MAX_UPLOAD_BYTES=26214400

# ---- Object storage: REQUIRED for media to publish reliably ---------------
# Buffer downloads every attachment from the public internet, at its own pace
# and often long after the post is created. A local tunnel cannot promise
# that: a free ngrok URL changes on restart, is rate limited, and will break
# every already-scheduled post pointing at it. A failed download is SILENT -
# the post goes out with no picture and no error.
#
# Cloudflare R2 is the cheapest option with no egress fees:
#   1. Create a bucket
#   2. Settings -> Public access -> enable the r2.dev URL (or a custom domain)
#   3. Create an R2 API token with Object Read & Write
#   4. Fill in the values below
MEDIA_STORAGE_BACKEND=local
S3_BUCKET=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# AWS S3:      https://s3.<region>.amazonaws.com
# MinIO:       http://localhost:9000
S3_ENDPOINT=
# R2 uses "auto"; AWS uses its region, e.g. "eu-west-1".
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public base objects are served from. R2: https://pub-<account>.r2.dev
S3_PUBLIC_BASE_URL=

# ---- AI (campaign generation) -------------------------------------------
# Maximum post generations run at once for one campaign.
AI_MAX_CONCURRENCY=4

# Ceiling on generations per hour per instance.
AI_GENERATIONS_PER_HOUR=120

# Per-campaign attempt cap.
AI_MAX_CHANNELS_PER_CAMPAIGN=60

# Seconds allowed for one provider request.
AI_TIMEOUT_SECONDS=90

# ==========================================================================
# Credentials are NOT environment variables
# ==========================================================================
# Buffer tokens and AI provider keys are entered in the UI, encrypted in the
# database with CREDENTIAL_ENCRYPTION_KEY, and never returned to the browser.
# That is deliberate: a key in a shell history or a container image leaks.
#
# They are never read from this file, never sent to n8n, and never written into
# a workflow export.
#
# After deploying to a new host, re-enter them once in Settings. See the
# "Moving to production" section of deploy/README.md.
# ==========================================================================
