# ==========================================================================
# Social Media Automation - environment variable reference
#
# THIS FILE IS THE INDEX, NOT A CONFIGURATION FILE.
#
# The app is configured in three separate places, each with its own template:
#
#   backend/.env              FastAPI.  Template: backend/.env.example
#   frontend/.env             Vite.     Template: frontend/.env.example
#   n8n instance settings     n8n.      See deploy/n8n/README.md
#
# Copy the two templates above and fill them in; nothing here needs to be
# copied anywhere. This file exists so you can see every variable the project
# actually reads, in one place, with no secrets in it.
#
#   Backend : backend/app/core/config.py       (pydantic-settings)
#   Frontend: frontend/src/services/api.ts     (import.meta.env)
#
# There is no value in this file that is not already a placeholder.
# ==========================================================================


# ##########################################################################
# RENDER - BACKEND SERVICE (FastAPI)
#
# Set these on the Render "Web Service" for the backend, under Environment.
# All of them are read at process start; a change triggers a restart.
# ##########################################################################

# ---- Required: database ---------------------------------------------------
# MUST be PostgreSQL in production. The backend refuses to start in
# APP_ENV=production while this points at SQLite, because an ephemeral
# filesystem would silently reset the database on every deploy.
#
# Supabase:  Project Settings -> Database -> Connection string -> URI
# Render Postgres: the `DATABASE_URL` Render shows when you create it
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB

# ---- Required: credential encryption --------------------------------------
# Encrypts every stored secret: Buffer tokens AND AI provider keys.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP. Without it, every stored credential is unreadable and must be
# re-entered in the UI. Changing it has the same effect.
CREDENTIAL_ENCRYPTION_KEY=

# Legacy fallback key, honoured only when CREDENTIAL_ENCRYPTION_KEY is unset.
# Leave empty on a new deployment.
AI_ENCRYPTION_KEY=

# ---- Required: API authentication ----------------------------------------
# Gate on every /api route via the X-API-Key header. The backend refuses to
# start in production without it.
# Generate with: openssl rand -base64 36
API_KEY=

# ---- Required: operator login (the browser sign-in) ---------------------
# This is what an actual human uses. There is NO default password: if this is
# unset, no operator exists and the login screen refuses every attempt rather
# than accepting anything.
#
# The backend hashes this with Argon2id on first boot and never stores the
# plaintext. Changing it later rotates the password AND signs out every device.
#
# Minimum 12 characters and must mix letters and numbers. Startup rejects
# obvious choices like "changeme".
APP_ADMIN_PASSWORD=
APP_ADMIN_USERNAME=admin

# Lifetime of a signed-in browser session, in hours.
AUTH_SESSION_TTL_HOURS=12

# "lax" is correct when the frontend and API share a registrable domain,
# which is the case for two *.onrender.com hosts. Use "none" only when they do
# not; browsers then require Secure (which is forced on in production).
AUTH_COOKIE_SAMESITE=lax

# Forced true whenever APP_ENV=production. Leave false for plain-HTTP local
# development.
AUTH_COOKIE_SECURE=false

# ---- Required: CORS -------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Must include your
# deployed frontend. Never use * in production - startup will reject it.
CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com

# ---- Required: publishing engine and n8n ----------------------------------
# "n8n"    backend -> n8n webhook -> workflow -> backend -> Buffer
# "direct" backend -> Buffer (no n8n needed at publish time)
PUBLISH_ENGINE=n8n

# The webhook the backend POSTs a publish request to. Use /webhook/, never
# /webhook-test/ (that only exists while the editor is open).
N8N_PUBLISH_WEBHOOK_URL=https://YOUR-N8N.onrender.com/webhook/social/publish

# Shared secret between the backend and the n8n workflow. Required when
# PUBLISH_ENGINE=n8n: without it /internal/publish returns 404 and nothing can
# publish. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# Must be identical to SMA_INTERNAL_SECRET on the n8n side.
INTERNAL_SERVICE_SECRET=

# Optional extra secret sent as X-N8N-Secret on the webhook itself.
N8N_WEBHOOK_SECRET=

# IMPORTANT: resolved by the N8N RUNTIME, so this must be an address the n8n
# container can reach - not one your browser can reach. In production this is
# the backend's own public URL.
N8N_BACKEND_BASE_URL=https://YOUR-BACKEND.onrender.com

N8N_TIMEOUT_SECONDS=60
N8N_VERIFY_TLS=true

# ---- Required: public URLs -----------------------------------------------
# The URL the BROWSER uses for thumbnails and previews.
PREVIEW_MEDIA_BASE_URL=https://YOUR-BACKEND.onrender.com/api/media

# Base used to build absolute media URLs when PUBLIC_MEDIA_BASE_URL is empty.
PUBLIC_API_BASE_URL=https://YOUR-BACKEND.onrender.com

# ---- Media storage --------------------------------------------------------
# "local" writes to MEDIA_STORAGE_DIR, which Render wipes on every redeploy.
# "s3"     writes to any S3-compatible bucket and gives stable public URLs.
#          This is what you want on Render. Buffer downloads attachments from
#          the public internet long after the post is created.
MEDIA_STORAGE_BACKEND=s3
MEDIA_STORAGE_DIR=/data/media

# Cloudflare R2 is the cheapest option with no egress fees.
S3_BUCKET=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# AWS S3:      https://s3.<region>.amazonaws.com
# MinIO:       http://localhost:9000
S3_ENDPOINT=
# R2 uses "auto"; AWS uses its region, e.g. "eu-west-1".
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public base objects are served from. R2: https://pub-<account>.r2.dev
# Objects MUST be publicly readable or Buffer cannot download them.
S3_PUBLIC_BASE_URL=

# Leave empty when using object storage. Otherwise it must be a public URL:
# a localhost or free-tunnel value breaks every post scheduled against it.
PUBLIC_MEDIA_BASE_URL=

# Ceiling for one IMAGE upload, in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400

# Ceiling for one VIDEO upload, in bytes (4 GB).
#
# Facebook takes a 4 GB Reel and a much larger uploaded video, so images and
# videos do not share a limit. Anything above UPLOAD_CHUNK_THRESHOLD_BYTES is
# sent in chunks, because a body that size does not pass through a reverse
# proxy in one request.
MAX_VIDEO_UPLOAD_BYTES=4294967296
UPLOAD_CHUNK_THRESHOLD_BYTES=26214400
# Size of one chunk in the chunked upload protocol. Keep this comfortably under
# any request-body limit your proxy imposes (Render and most CDNs cap around
# 32-100 MB). Uploads are chunked at UPLOAD_CHUNK_THRESHOLD_BYTES and above.
UPLOAD_CHUNK_BYTES=8388608
# How long an unfinished upload is kept before it is swept from disk.
UPLOAD_SESSION_TTL_HOURS=24
# Where in-progress uploads are staged. Defaults to MEDIA_STORAGE_DIR/uploads.
# It needs free disk for the largest video you accept.
UPLOAD_STAGING_DIR=

# ---- Application ----------------------------------------------------------
APP_ENV=production
DEBUG=false
DEFAULT_TIMEZONE=Asia/Dhaka
MAX_SCHEDULE_DAYS_AHEAD=365

# AI campaign generation limits.
AI_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENCY=4
AI_MAX_CHANNELS_PER_CAMPAIGN=60
AI_GENERATIONS_PER_HOUR=120

# Buffer API. Only change if Buffer moves its endpoint.
BUFFER_API_BASE_URL=https://api.buffer.com
BUFFER_TIMEOUT_SECONDS=30


# ##########################################################################
# RENDER - FRONTEND SERVICE (static site)
#
# Vite inlines VITE_* variables at BUILD time, so these are BUILD-time
# variables on Render, not runtime ones. Changing one triggers a new build.
# ##########################################################################

VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
VITE_DEFAULT_TIMEZONE=Asia/Dhaka

# Only set this if the backend has API_KEY set. It is compiled into the
# JavaScript bundle and is therefore visible to anyone who opens the app: it
# is an origin gate, NOT user authentication.
VITE_API_KEY=


# ##########################################################################
# RENDER - N8N SERVICE
#
# Set these on the n8n "Web Service". See deploy/n8n/README.md.
# ##########################################################################

# ---- Required: n8n's credential vault key --------------------------------
# n8n refuses persisted credentials without it, and generates a new one on
# every boot if it is absent - which makes every saved credential unreadable
# after a restart. Generate with: openssl rand -base64 36
# BACK THIS UP.
N8N_ENCRYPTION_KEY=

# ---- Required: persistence ------------------------------------------------
# Set this if n8n has its own PostgreSQL (strongest option, works on the free
# tier). Without it you MUST attach a Render Persistent Disk mounted at
# /home/node/.n8n, or every workflow and credential is lost on redeploy.
#
#   DB_TYPE=postgresdb
#   DB_POSTGRESDB_HOST=...
#   DB_POSTGRESDB_PORT=5432
#   DB_POSTGRESDB_DATABASE=...
#   DB_POSTGRESDB_USER=...
#   DB_POSTGRESDB_PASSWORD=...

# ---- Required: read by the workflow JSON ---------------------------------
# deploy/n8n/social-publishing-workflow.json reads these two. They are the
# ENTIRE per-deployment configuration the workflow needs - accounts, channels,
# credentials and AI providers are all managed in the app, not in the workflow.
#
# SMA_BACKEND_URL     the backend base URL AS SEEN FROM n8n. "localhost" means
#                     the n8n container itself, not your machine.
# SMA_INTERNAL_SECRET must equal the backend's INTERNAL_SERVICE_SECRET.
SMA_BACKEND_URL=https://YOUR-BACKEND.onrender.com
SMA_INTERNAL_SECRET=

# ---- Correct public webhook URLs -----------------------------------------
# Without these n8n generates webhook URLs pointing at localhost and the
# backend will never be able to reach the workflow.
N8N_HOST=YOUR-N8N.onrender.com
WEBHOOK_URL=https://YOUR-N8N.onrender.com/
N8N_EDITOR_BASE_URL=https://YOUR-N8N.onrender.com/
N8N_PROTOCOL=https

# Render terminates TLS and proxies over HTTP, so the Secure cookie flag must
# be off or you cannot log in to the n8n editor.
N8N_SECURE_COOKIE=false

GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka
N8N_DIAGNOSTICS_ENABLED=false


# ##########################################################################
# NEVER PUT THESE ANYWHERE THAT GETS COMMITTED
# ##########################################################################
#
# Buffer access tokens and AI provider keys are NOT environment variables.
# They are entered in the app UI, encrypted in the database with
# CREDENTIAL_ENCRYPTION_KEY, and never returned to the browser.
#
# That is deliberate: a key in a shell history, a Dockerfile, a workflow export
# or an image layer leaks, and every one of those is captured by git.
#
# After the first production deploy, open Settings -> Buffer Integrations and
# Settings -> AI providers and re-enter them once.
# ==========================================================================