# ==========================================================================
# Production configuration TEMPLATE.
#
#   cp deploy/.env.production.example deploy/.env.production
#   # then fill in every value marked REQUIRED
#
# deploy/.env.production is gitignored. Never commit the filled-in copy.
#
# Nothing in the application code changes between local and production. This
# file is the entire difference.
# ==========================================================================

# ---- Domains -------------------------------------------------------------
# Your frontend, API and n8n hosts. DNS for all three must already point at
# this machine before you start, or certificate issuance fails.
PUBLIC_SITE_ADDRESS=your-domain.com
PUBLIC_API_HOST=api.your-domain.com
N8N_HOST=n8n.your-domain.com
ACME_EMAIL=you@your-domain.com

# Full public URLs, no trailing slash.
PUBLIC_API_BASE_URL=https://api.your-domain.com
PREVIEW_MEDIA_BASE_URL=https://api.your-domain.com/api/media
N8N_PUBLIC_URL=https://n8n.your-domain.com/

# ---- Application ---------------------------------------------------------
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://your-domain.com
DEFAULT_TIMEZONE=Asia/Dhaka

# ---- Database (REQUIRED) -------------------------------------------------
# The container hostname `db` is the Postgres service on the internal network.
DATABASE_URL=postgresql+psycopg://sma:CHANGE_ME@db:5432/social
POSTGRES_USER=sma
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=social

# ---- Secrets (REQUIRED) --------------------------------------------------
# Encrypts every stored Buffer token and AI provider key.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP. If you lose it, every stored credential becomes unreadable and
# must be re-entered in the UI. Changing it has the same effect.
CREDENTIAL_ENCRYPTION_KEY=

# Gate on every /api route. Generate: openssl rand -base64 36
API_KEY=

# Shared secret between the backend and the n8n workflow.
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Must match SMA_INTERNAL_SECRET, which the compose file passes to n8n from
# this same value - so setting it once here covers both sides.
INTERNAL_SERVICE_SECRET=

# n8n's own encryption key. n8n refuses to start without it.
# Generate:  openssl rand -base64 36
N8N_ENCRYPTION_KEY=
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=CHANGE_ME
N8N_POSTGRES_DB=n8n

# ---- Publishing engine ---------------------------------------------------
# n8n    -> backend -> n8n workflow -> Buffer (keeps the workflow in the loop)
# direct -> backend -> Buffer (one less hop, no n8n dependency at publish time)
PUBLISH_ENGINE=n8n

# ---- Backend <-> n8n -----------------------------------------------------
# The webhook the backend POSTs to.
N8N_PUBLISH_WEBHOOK_URL=https://n8n.your-domain.com/webhook/social/publish

# Shared secret on the webhook itself. Optional but recommended.
N8N_WEBHOOK_SECRET=

# IMPORTANT: this is resolved by the N8N RUNTIME, so it must be an address the
# n8n container can reach - not one your browser can reach.
# Inside the compose network the backend service is simply "backend":
N8N_BACKEND_BASE_URL=http://backend:8000

# ---- Media (REQUIRED for images) ----------------------------------------
# Buffer downloads attachments from the public internet. Use object storage.
MEDIA_STORAGE_BACKEND=s3
S3_BUCKET=your-media-bucket
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# AWS S3:      https://s3.<region>.amazonaws.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Objects must be publicly readable: https://pub-<account>.r2.dev
S3_PUBLIC_BASE_URL=
# Leave empty when using object storage.
PUBLIC_MEDIA_BASE_URL=
