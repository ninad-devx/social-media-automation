# ==========================================================================
# Frontend configuration
# Copy to frontend/.env (Vite only exposes vars prefixed with VITE_).
#
# Everything here is baked into the browser bundle at BUILD time, so treat it
# as public. Only URLs and non-secret preferences belong in this file.
# ==========================================================================

# Base URL of the FastAPI backend.
# Local:  http://localhost:8000
# Prod:   https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8000

# Pre-selected timezone in Quick Publish. Any IANA zone.
VITE_DEFAULT_TIMEZONE=Asia/Dhaka

# Optional. Only needed if the backend has API_KEY set.
# NOTE: this key is visible to anyone who opens the app. It is a rate-limit /
# origin gate, not user authentication. Put real auth in front of the app if
# you need per-user access control.
VITE_API_KEY=

# ==========================================================================
# NOT SET HERE, ON PURPOSE
# ==========================================================================
# Buffer API tokens, AI provider keys, the credential encryption key and the
# internal service secret are NEVER available to the browser. They live only
# in the backend, encrypted at rest.
#
# The browser talks to our own backend and nothing else.
# ==========================================================================
